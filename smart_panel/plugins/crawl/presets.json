    "google-news-search": {
      "kind": "rss",
      "label": "Google News",
      "url": "https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en",
      "interval_s": 300,
      "max_items": 30
    },
    "google-news-topic": {
      "kind": "rss",
      "label": "Google News",
      "url": "https://news.google.com/rss/headlines/section/topic/{topic}?hl=en-US&gl=US&ceid=US:en",
